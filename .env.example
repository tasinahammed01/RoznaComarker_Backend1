# Core
HOST=0.0.0.0
PORT=5000
NODE_ENV=development
APP_DEPLOYMENT_REVISION=
MONGO_URI=mongodb://127.0.0.1:27017/rozna
JWT_SECRET=replace_with_a_long_random_secret

# Global ordered AI model chain
AI_PRIMARY_PROVIDER=google
AI_PRIMARY_MODEL=gemini-3.6-flash
AI_FALLBACK_1_PROVIDER=openrouter
AI_FALLBACK_1_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
AI_FALLBACK_2_PROVIDER=openrouter
AI_FALLBACK_2_MODEL=nvidia/nemotron-3-super-120b-a12b:free
AI_FALLBACK_3_PROVIDER=openrouter
AI_FALLBACK_3_MODEL=openai/gpt-oss-20b:free
AI_ATTEMPT_TIMEOUT_MS=45000
AI_TOTAL_BUDGET_MS=200000
# Preferred retry policy
AI_PRIMARY_RETRIES=1
AI_FALLBACK_RETRIES=0
AI_RETRY_DELAY_MS=1500
# Legacy compatibility only
# AI_RETRIES_PER_MODEL=0

# Paid assessment chain (rubrics and assignment/submission evaluation only)
ASSESSMENT_AI_PRIMARY_PROVIDER=openrouter
ASSESSMENT_AI_PRIMARY_MODEL=openai/gpt-4.1-mini
ASSESSMENT_AI_FALLBACK_1_PROVIDER=openrouter
ASSESSMENT_AI_FALLBACK_1_MODEL=openai/gpt-4.1
ASSESSMENT_AI_ATTEMPT_TIMEOUT_MS=60000
ASSESSMENT_AI_TOTAL_BUDGET_MS=180000
ASSESSMENT_AI_PRIMARY_RETRIES=1
ASSESSMENT_AI_FALLBACK_RETRIES=0
ASSESSMENT_AI_RETRY_DELAY_MS=0

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Feature-specific output-size limits only
RUBRIC_AI_MAX_OUTPUT_TOKENS=6000
SEMANTIC_AI_MAX_OUTPUT_TOKENS=12000
DETAILED_FEEDBACK_AI_MAX_OUTPUT_TOKENS=6000
ADAPTIVE_PRACTICE_AI_MAX_OUTPUT_TOKENS=6000
SENSITIVE_RATE_LIMIT_WINDOW_MS=900000
SENSITIVE_RATE_LIMIT_MAX=20
# Phase 2 abuse/cost protection. Defaults are classroom-friendly and may be
# tuned from observed production traffic without code changes.
RATE_LIMIT_WINDOW_MS=900000
BASELINE_RATE_LIMIT_MAX=300
LOGIN_IP_RATE_LIMIT_WINDOW_MS=900000
LOGIN_IP_RATE_LIMIT_MAX=60
LOGIN_ACCOUNT_RATE_LIMIT_WINDOW_MS=900000
LOGIN_ACCOUNT_RATE_LIMIT_MAX=10
EMAIL_IP_RATE_LIMIT_WINDOW_MS=900000
EMAIL_IP_RATE_LIMIT_MAX=20
EMAIL_ADDRESS_RATE_LIMIT_WINDOW_MS=900000
EMAIL_ADDRESS_RATE_LIMIT_MAX=5
EMAIL_COOLDOWN_MS=60000
EMAIL_DAILY_RATE_LIMIT_MAX=20
AI_USER_RATE_LIMIT_WINDOW_MS=300000
AI_USER_RATE_LIMIT_MAX=10
UPLOAD_USER_RATE_LIMIT_WINDOW_MS=900000
UPLOAD_USER_RATE_LIMIT_MAX=30
SSE_TOKEN_RATE_LIMIT_WINDOW_MS=60000
SSE_TOKEN_RATE_LIMIT_MAX=12
JSON_BODY_LIMIT=1mb
URLENCODED_BODY_LIMIT=256kb
MAX_FILE_SIZE=10485760
MAX_TOTAL_UPLOAD_SIZE=52428800
# Production topology assumption: exactly one trusted CloudPanel/Nginx hop.
# Do not use an unrestricted boolean trust-proxy configuration.
TRUST_PROXY=true
AI_CORRECTION_CONTENT_MIN_CONFIDENCE=0.75
AI_CORRECTION_ORGANIZATION_MIN_CONFIDENCE=0.75
AI_CORRECTION_VOCABULARY_MIN_CONFIDENCE=0.80
AI_CORRECTION_GRAMMAR_MIN_CONFIDENCE=0.85
AI_CORRECTION_MECHANICS_MIN_CONFIDENCE=0.90
ADAPTIVE_PRACTICE_CHECK_AI_MAX_OUTPUT_TOKENS=3000
FLASHCARD_AI_MAX_OUTPUT_TOKENS=4000
WORKSHEET_AI_MAX_OUTPUT_TOKENS=6000
WORKSHEET_OCR_MAX_OUTPUT_TOKENS=8000

# Class-invitation SMTP only; Firebase sends verification and password-reset mail directly
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_EMAIL=no-reply@roznahub.com
MAIL_FROM_NAME=CoMarker

# Firebase Admin authentication (never reuse the Vision credential here)
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_service_account_email
FIREBASE_PRIVATE_KEY=your_private_key

# Google Vision OCR credential (may belong to a separate Google Cloud project)
GOOGLE_CLOUD_KEY_FILE=./key/vision_key.json

# Unsplash
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
UNSPLASH_SECRET_KEY=your_unsplash_secret_key_here

# Public URLs
BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:4200
APP_FRONTEND_URL=http://localhost:4200
PUBLIC_API_URL=http://localhost:5000
# Stripe test mode (never commit real keys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:4200
CORS_ORIGINS=http://localhost:4200

# Production origin example (copy these values into the deployment environment;
# do not commit the real production .env):
# NODE_ENV=production
# HOST=127.0.0.1
# PUBLIC_API_URL=https://comarkerback.roznahub.com
# BASE_URL=https://comarkerback.roznahub.com
# FRONTEND_URL=https://comarkers.roznahub.com
# APP_FRONTEND_URL=https://comarkers.roznahub.com
# CORS_ALLOWED_ORIGINS=https://comarkers.roznahub.com
# CORS_ORIGINS=https://comarkers.roznahub.com

PDF_CHROME_NO_SANDBOX=false
