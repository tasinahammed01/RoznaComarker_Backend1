{
  "name": "backend",
  "version": "1.0.0",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "verify:runtime": "node scripts/verify-runtime-contract.js",
    "verify:production-security": "node scripts/verify-production-security.js --dry-run",
    "test": "jest --runInBand",
    "seed:phase1b-pricing": "node scripts/seedPhase1bPricing.js",
    "seed:assessment-credit-packs": "node scripts/seedAssessmentCreditPacks.js",
    "paypal:provision:sandbox": "node scripts/paypal/provisionSandboxPlans.js",
    "paypal:webhook:sandbox": "node scripts/paypal/provisionSandboxWebhook.js",
    "paypal:check": "node scripts/paypal/checkConfiguration.js",
    "paypal:check:auth": "node scripts/paypal/checkConfiguration.js --auth",
    "paypal:validate-resources": "node scripts/paypal/validateResources.js",
    "benchmark:semantic": "node scripts/benchmarkSemanticAnalysis.js",
    "test:live-gemini-smoke": "node scripts/liveGeminiSemanticSmoke.js",
    "test:live-flashcard-gemini": "node scripts/liveFlashcardGeminiSmoke.js",
    "test:live-worksheet-gemini": "node scripts/liveWorksheetGeminiSmoke.js"
  },
  "dependencies": {
    "@google-cloud/vision": "^4.3.3",
    "@google/generative-ai": "^0.24.1",
    "canvas": "^3.2.3",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "css-tree": "^3.1.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.6.0",
    "express-validator": "^7.2.1",
    "firebase-admin": "^12.7.0",
    "groq-sdk": "^1.2.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "image-size": "^1.2.1",
    "jsonrepair": "^3.14.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.6.0",
    "mongoose": "^9.1.2",
    "morgan": "^1.11.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.4",
    "openai": "^6.34.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^3.11.174",
    "pdfkit": "^0.16.0",
    "pdfmake": "^0.3.8",
    "puppeteer": "^24.39.1",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.34.5",
    "stripe": "^22.5.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.22.3",
    "undici": "^6.28.0",
    "uuid": "^11.1.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.1",
    "@types/pdfjs-dist": "^2.10.377",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.1.8",
    "nodemon": "^3.1.11",
    "supertest": "^6.3.4",
    "typescript": "^6.0.3"
  },
  "jest": {
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ],
    "transform": {
      "^.+\\.[cm]?[jt]sx?$": "<rootDir>/tests/helpers/typescriptJestTransformer.cjs"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(sanitize-html|htmlparser2|dom-serializer|domhandler|domutils|domelementtype|entities)/)"
    ]
  }
}
